        <mxCell id="8gsnCrVEzhBmshTpCWMb-53" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" value="Описание" vertex="1">
